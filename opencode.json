{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-metasearch2"
  ],
  "subagent_depth": 3,
  "provider": {
    "ollama": {
      "models": {
        "qwen2.5:14b-instruct-q5_K_M": {
          "_launch": true,
          "name": "qwen2.5:14b-instruct-q5_K_M"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:TAVILY_API_KEY}"
      },
      "enabled": true
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:FIRECRAWL_API_KEY}"
      },
      "enabled": true
    },
    "langsearch": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "langsearch-mcp-server"],
      "environment": {
        "LANGSEARCH_API_KEY": "{env:LANGSEARCH_API_KEY}"
      },
      "timeout": 30000,
      "enabled": true
    },
    "serper": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "serper-search-mcp"],
      "environment": {
        "SERPER_API_KEY": "{env:SERPER_API_KEY}"
      },
      "timeout": 30000,
      "enabled": true
    },
    "you": {
      "type": "remote",
      "url": "https://api.you.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:YDC_API_KEY}"
      },
      "enabled": true
    },
    "you-free": {
      "type": "remote",
      "url": "https://api.you.com/mcp?profile=free",
      "enabled": true
    },
    "you-finance": {
      "type": "remote",
      "url": "https://api.you.com/mcp?tools=you-finance",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:YDC_API_KEY}"
      },
      "enabled": true
    },
    "you-docs": {
      "type": "remote",
      "url": "https://you.com/docs/_mcp/server",
      "enabled": true
    }
  },
  "agent": {
    "b0tts-researcher": {
      "model": "opencode-go/muse-spark-1.2-contributor",
      "reasoningEffort": "xhigh"
    },
    "b0tts-smart-agent": {
      "model": "opencode-go/deepseek-v4-pro",
      "reasoningEffort": "max"
    },
    "b0tts-general-agent": {
      "model": "opencode-go/muse-spark-1.2-contributor",
      "reasoningEffort": "xhigh"
    },
    "b0tts-lead-researcher": {
      "model": "opencode-go/muse-spark-1.2-contributor",
      "reasoningEffort": "xhigh"
    },
    "general": {
      "model": "opencode-go/muse-spark-1.2-contributor",
      "reasoningEffort": "xhigh"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "reasoningEffort": "max"
    }
  }
}