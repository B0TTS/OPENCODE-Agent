{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-metasearch2"
  ],
  "permission": {
    "read": {
      "<PROJECT>/.opencode/get-shit-done/*": "allow"
    },
    "external_directory": {
      "<PROJECT>/.opencode/get-shit-done/*": "allow"
    }
  },
  "provider": {
    "ollama": {
      "models": {
        "<model-id>": {
          "_launch": true,
          "name": "<model-id>"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "docs-mcp-server": {
      "type": "remote",
      "url": "http://<your-ip>:6280/mcp"
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "EXA_API_KEY": "{env:EXA_API_KEY}"
      },
      "enabled": true
    }
  },
  "agent": {
    "gsd-roadmapper": {
      "model": "<your-model>",
      "reasoning": "high"
    },
    "gsd-planner": {
      "model": "<your-model>",
      "reasoning": "high"
    },
    "gsd-plan-checker": {
      "model": "<your-model>",
      "reasoning": "max"
    },
    "general": {
      "model": "<your-model>",
      "reasoning": "high"
    }
  }
}
